{
  "name": "ghtun",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postAttachCommand": {
    "setup-xray": "tmux has-session -t ghtun 2>/dev/null || tmux new-session -d -s ghtun 'sudo /usr/local/bin/xray -c /etc/config.json'; gh codespace ports visibility 443:public -c $CODESPACE_NAME"
  },
  "portsAttributes": {
    "443": {
      "label": "xray",
      "protocol": "https",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  },
  "remoteUser": "root"
}
